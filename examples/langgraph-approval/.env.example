LUMOAUTH_URL=https://app.lumoauth.dev
# For an organization on its own domain, set the domain here. LUMOAUTH_URL and
# LUMOAUTH_ORG_ID are then not used.
# LUMOAUTH_CUSTOM_DOMAIN=auth.acme.com
# Your organization slug, and the agent's client credentials
LUMOAUTH_ORG_ID=
AGENT_CLIENT_ID=
AGENT_CLIENT_SECRET=
# The user who approves on their phone (the LumoAuth app is enrolled there)
APPROVER_EMAIL=
# The model that plans the payment
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
